{
  "$schema": "https://eshobe.com/schemas/theme-manifest.json",
  "contractVersion": 1,
  "key": "coffee-menu",
  "name": "Coffee Menu",
  "nameFa": "منوی کافه",
  "siteTypes": ["store", "business"],
  "locales": ["fa", "en"],
  "proxiesApi": true,
  "capabilities": {
    "commerce": true,
    "catalogue": true,
    "search": false,
    "blog": false,
    "contactForm": false
  },
  "design": {
    "primary": "#a9764b",
    "accent": "#d9a441",
    "background": "#faf5ef",
    "foreground": "#3b2c22",
    "radius": "md",
    "lineHeight": 1.5
  },
  "settings": {
    "menuTitle": {
      "type": "text",
      "default": "Menu",
      "group": "general",
      "labelEn": "Breadcrumb title",
      "labelFa": "عنوان مسیر صفحه",
      "help": "متن لینک «Menu» در بالای صفحه. خالی بگذارید تا پیش‌فرض بماند."
    }
  },
  "build": {
    "buildPack": "dockerfile",
    "baseDirectory": "/",
    "dockerfileLocation": "Dockerfile",
    "installCommand": null,
    "buildCommand": null,
    "startCommand": null,
    "publishDirectory": null,
    "port": 3000,
    "healthCheckPath": "/api/health",
    "isStatic": false
  },
  "env": [
    { "key": "ESHOBE_CMS_URL", "source": "platform" },
    { "key": "ESHOBE_SITE_DOMAIN", "source": "platform" },
    { "key": "ESHOBE_SITE_ID", "source": "platform" },
    { "key": "ESHOBE_API_KEY", "source": "platform", "secret": true },
    { "key": "ESHOBE_PUBLIC_ORIGIN", "source": "platform" },
    { "key": "ESHOBE_REVALIDATE_SECRET", "source": "platform", "secret": true },
    { "key": "ESHOBE_DEFAULT_LOCALE", "source": "platform" },
    { "key": "ESHOBE_LOCALES", "source": "platform" },
    { "key": "ESHOBE_CURRENCY", "source": "platform" },
    { "key": "ESHOBE_CONTRACT_VERSION", "source": "platform" }
  ]
}
